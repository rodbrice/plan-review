{
  "version": 4,
  "terraform_version": "1.17.2",
  "serial": 1,
  "lineage": "00000000-0000-4000-8000-000000000005",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_iam_policy",
      "name": "orders_reader",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "arn:aws:iam::123456789012:policy/example-orders-reader",
            "arn": "arn:aws:iam::123456789012:policy/example-orders-reader",
            "name": "example-orders-reader",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"dynamodb:GetItem\",\"dynamodb:Query\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:dynamodb:eu-central-1:123456789012:table/example-orders\"}],\"Version\":\"2012-10-17\"}",
            "tags": {},
            "tags_all": {}
          },
          "sensitive_attributes": []
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_iam_policy",
      "name": "deployer",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "arn:aws:iam::123456789012:policy/example-deployer",
            "arn": "arn:aws:iam::123456789012:policy/example-deployer",
            "name": "example-deployer",
            "path": "/",
            "policy": "{\"Statement\":[{\"Action\":[\"s3:DeleteObject\",\"s3:PutObject\"],\"Effect\":\"Allow\",\"Resource\":\"arn:aws:s3:::example-app-assets/*\"}],\"Version\":\"2012-10-17\"}",
            "tags": {},
            "tags_all": {}
          },
          "sensitive_attributes": []
        }
      ]
    }
  ]
}
